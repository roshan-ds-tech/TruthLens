#!/bin/sh
# TruthLens CLI wrapper: ./truthlens analyze <files> | rerun --case C-0001 | report --case C-0001 | validate
DIR="$(cd "$(dirname "$0")" && pwd)"
export DYLD_FALLBACK_LIBRARY_PATH="${DYLD_FALLBACK_LIBRARY_PATH:-/opt/homebrew/lib}"
exec "$DIR/backend/.venv/bin/python" "$DIR/backend/cli.py" "$@"
