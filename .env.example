# Frontend (Vercel project → Settings → Environment Variables)
VITE_API_BASE=https://<hf-user>-truthlens-api.hf.space

# Backend (set on the Hugging Face Space by the deploy workflow)
TRUTHLENS_MODE=hosted
TRUTHLENS_ALLOWED_ORIGINS=https://truthlens.vercel.app
TRUTHLENS_ALLOWED_ORIGIN_REGEX=https://truthlens-.*\.vercel\.app
TRUTHLENS_ALLOW_SIGNUP=1
